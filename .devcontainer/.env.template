# Dev container settings. Copy to .devcontainer/.env and fill in.
# API credentials live in Config/.env instead -- see Config/.env.template.
#
# Compose loads this file for ${...} interpolation in docker-compose.yml
# because it sits in the Compose project directory. It does NOT inject these
# variables into the container by itself.

# Jupyter server token. Leave empty for a tokenless local server; set it to any
# string to require that token in the login URL.
JUPYTER_TOKEN=

# Host port that maps to the container's 8888. Change it if 8888 is already
# taken on your machine.
JUPYTER_PORT=8888
